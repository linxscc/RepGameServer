# Copy to .env before starting. Never commit the real .env file.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=8000
GAME_PORT=9060
API_BIND_ADDRESS=127.0.0.1

DB_BIND_ADDRESS=127.0.0.1
DB_EXPOSE_PORT=13306
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# Must contain at least 32 random characters.
VOYARA_JWT_SECRET=replace-with-at-least-32-random-characters
APP_ENV=development
TZ=Asia/Tokyo

# Only needed when the browser frontend and API use different origins.
# Example: ALLOWED_ORIGINS=https://example.com,http://203.0.113.10
ALLOWED_ORIGINS=

# local stores product images on a Docker volume; s3 retains the old AWS path.
STORAGE_DRIVER=local

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
STRIPE_SECRET_KEY=

# Required only when STORAGE_DRIVER=s3.
AWS_S3_BUCKET=
AWS_S3_REGION=ap-southeast-2
AWS_S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Namecheap Dynamic DNS. Use the domain-specific DDNS password, not your account password.
DDNS_DOMAIN=zsdimain.site
DDNS_HOST=@
DDNS_INTERVAL=300
NAMECHEAP_DDNS_PASSWORD=

# Let's Encrypt certificate domain.
CERTBOT_DOMAIN=zsdimain.site
