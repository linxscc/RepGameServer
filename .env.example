BIND_ADDRESS=0.0.0.0
GAME_PORT=19060

DB_BIND_ADDRESS=127.0.0.1
DB_EXPOSE_PORT=23306
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
TZ=Asia/Tokyo

# TLS: certificate is auto-generated on first start and kept in the
# repgame_game_tls_certs volume. List every IP/hostname clients use to connect.
# The SHA-256 fingerprint is printed in the gameserver log; put it into the
# client's .env as SERVER_CERT_SHA256.
TLS_HOSTS=192.168.2.163,localhost,127.0.0.1

# Optional Namecheap DDNS for a dynamic home public IPv4 address.
DDNS_DOMAIN=zsdimain.site
DDNS_HOST=@
DDNS_INTERVAL=300
NAMECHEAP_DDNS_PASSWORD=
